# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=
# Supported open-weight models include: qwen/qwen3.8-27b, openai/gpt-oss-120b, llama-3.3-70b-versatile
GROQ_MODEL=qwen/qwen3.8-27b

# Server Configuration
HOST=127.0.0.1
PORT=8000
REQUEST_TIMEOUT=60

# Research & Validation Limits
MAX_QUESTION_LENGTH=5000
MAX_RESEARCH_RESULTS=5
